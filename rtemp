os.loadAPI("ocs/apis/sensor")

local sensorSide = "top" -- Change to "bottom", "left", "right", "front", or "back"

-- Check if a peripheral actually exists on that side before wrapping
if not peripheral.isPresent(sensorSide) then
    error("No peripheral attached to the " .. sensorSide .. " side!")
end

-- Native ComputerCraft wrap prevents the line 3 nil crash
local mySensor = peripheral.wrap(sensorSide)

while true do
    term.clear()
    term.setCursorPos(1, 1)
    
    local targets = mySensor.getTargets()
    
    if type(targets) ~= "table" then
        print("Status: Waiting for sensor data...")
        print("- Is the Machine Sensor Card inserted?")
    else
        local reactorFound = false
        
        for targetKey, _ in pairs(targets) do
            local details = mySensor.getTargetDetails(targetKey)
            
            if type(details) == "table" then
                local name = details.Name or details.name or ""
                
                -- Detect reactor or reactor chamber blocks
                if name:find("Reactor") or name:find("Chamber") or details.Heat ~= nil or details.heat ~= nil then
                    reactorFound = true
                    
                    local currentHeat = 0
                    local maxHeat = 10000
                    
                    if type(details.Heat) == "number" then
                        currentHeat = details.Heat
                        maxHeat = type(details.MaxHeat) == "number" and details.MaxHeat or 10000
                    elseif type(details.Heat) == "table" then
                        currentHeat = details.Heat.Heat or details.Heat.val or details.Heat.value or 0
                        maxHeat = details.Heat.MaxHeat or details.Heat.max or 10000
                    elseif type(details.heat) == "number" then
                        currentHeat = details.heat
                        maxHeat = type(details.maxHeat) == "number" and details.maxHeat or 10000
                    end
                    
                    local percentage = math.floor((currentHeat / maxHeat) * 100)
                    
                    print("=== REACTOR MONITOR ===")
                    print("Block: " .. name)
                    print("Heat: " .. currentHeat .. " / " .. maxHeat)
                    print("Temp: " .. percentage .. "%")
                    break
                end
            end
        end
        
        if not reactorFound then
            print("Sensor online, but no IC2 Reactor detected nearby.")
            print("Ensure the Sensor Peripheral is within 5 blocks of the reactor.")
        end
    end
    
    os.sleep(1)
end
