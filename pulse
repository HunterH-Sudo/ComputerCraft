-- Configuration
local redstoneSide = "back"  -- Options: "top", "bottom", "left", "right", "front", "back"
local sleepSeconds = 120     -- 2 minutes
local pulseDuration = 1      -- How long the redstone pulse stays ON (in seconds)

print("Starting redstone pulse timer...")
print("Pulsing " .. redstoneSide .. " side every " .. (sleepSeconds / 60) .. " minutes.")

while true do
    -- Wait 2 minutes
    os.sleep(sleepSeconds)
    
    -- Turn redstone signal ON
    redstone.setOutput(redstoneSide, true)
    print("Pulse SENT at " .. textutils.formatTime(os.time(), true))
    
    -- Wait 1 second while ON
    os.sleep(pulseDuration)
    
    -- Turn redstone signal OFF
    redstone.setOutput(redstoneSide, false)
end
