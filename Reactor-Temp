os.loadAPI("ocs/apis/sensor")

local sensorSide = "top" -- Side with Sensor Peripheral
local mySensor = sensor.wrap(sensorSide)

if not mySensor then
    error("No sensor found on " .. sensorSide .. " side!")
end

while true do
    term.clear()
    term.setCursorPos(1, 1)
    
    local targets = mySensor.getTargets()
    local reactorFound = false

    for targetKey, _ in pairs(targets) do
        local details = mySensor.getTargetDetails(targetKey)
        
        -- OpenCCSensors places IC2 Reactor properties inside sub-tables or under Raw/Heat
        if details then
            local currentHeat = 0
            local maxHeat = 10000

            -- Handle nested table structure safely
            if type(details.Heat) == "table" then
                currentHeat = details.Heat.Heat or details.Heat.val or 0
                maxHeat = details.Heat.MaxHeat or 10000
            elseif type(details.Heat) == "number" then
                currentHeat = details.Heat
            elseif details.Raw and details.Raw.Heat then
                currentHeat = details.Raw.Heat
                maxHeat = details.Raw.MaxHeat or 10000
            end

            -- Verify we found a valid reactor target
            if details.name and details.name:find("Reactor") or currentHeat > 0 or details.MaxHeat then
                reactorFound = true
                maxHeat = (type(details.MaxHeat) == "number" and details.MaxHeat) or maxHeat
                
                local percentage = math.floor((currentHeat / maxHeat) * 100)

                print("=== REACTOR MONITOR ===")
                print("Heat: " .. currentHeat .. " / " .. maxHeat)
                print("Temperature: " .. percentage .. "%")
                break
            end
        end
    end

    if not reactorFound then
        print("Searching for IC2 Nuclear Reactor...")
        print("Ensure Machine Card is inside Sensor Peripheral!")
    end

    os.sleep(1)
end
